# Copy to .env (chmod 600). Never commit real keys. Never paste tokens into chat.
#
# Connect whichever model you want. Parley does not lock a vendor.
# Set HERMES_PROVIDER + HERMES_MODEL and the matching key, then recreate.

# Gemini
# HERMES_PROVIDER=gemini
# HERMES_MODEL=gemini-3.6-flash
# GEMINI_API_KEY=
# GOOGLE_API_KEY=

# DeepSeek
# HERMES_PROVIDER=deepseek
# HERMES_MODEL=deepseek-flash
# DEEPSEEK_API_KEY=

# Claude
# HERMES_PROVIDER=anthropic
# HERMES_MODEL=claude-sonnet-4
# ANTHROPIC_API_KEY=

# OpenAI Codex (OAuth inside the container: hermes auth add openai-codex)
# HERMES_PROVIDER=openai-codex

# TZ=UTC
# AGENT_ID=parley
# PARLEY_LOCALE=pt
# PARLEY_PRACTICE_HOUR=18
